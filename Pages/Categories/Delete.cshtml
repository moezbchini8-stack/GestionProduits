@page "{id:int}"
@model GestionProduits.Pages.Categories.DeleteModel
@{ ViewData["Title"] = "Supprimer la catégorie"; }
<h1>Supprimer la catégorie ?</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div><p>Catégorie : <strong>@Model.Categorie.Nom</strong></p>@if (Model.ContientProduits) {<div class="alert alert-warning">Suppression impossible : cette catégorie contient des produits.</div>} else {<form method="post"><button type="submit" class="btn btn-danger">Confirmer la suppression</button></form>}<a asp-page="Index">Retour</a>
