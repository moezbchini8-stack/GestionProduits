@page "{id:int}"
@model GestionProduits.Pages.Produits.DeleteModel

@{
    ViewData["Title"] = "Supprimer le produit";
}

<div class="row justify-content-center">

    <div class="col-md-7 col-lg-6">

        <div class="mb-4">
            <h1 class="fw-bold">Supprimer le produit</h1>
            <p class="text-muted">
                Vérifiez les informations avant de supprimer ce produit.
            </p>
        </div>

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <div class="alert alert-warning">
                    <strong>Attention !</strong>
                    Cette action est définitive.
                </div>

                <dl class="row mb-4">

                    <dt class="col-sm-4">
                        Nom
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Produit.Nom
                    </dd>


                    <dt class="col-sm-4">
                        Prix
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Produit.Prix.ToString("0.00") DT
                    </dd>


                    <dt class="col-sm-4">
                        Catégorie
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Produit.Categorie?.Nom
                    </dd>

                </dl>

                <form method="post">

                    <input type="hidden" asp-for="Produit.Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">
                            Oui, supprimer
                        </button>

                        <a asp-page="./Index"
                           class="btn btn-secondary">
                            Annuler
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>