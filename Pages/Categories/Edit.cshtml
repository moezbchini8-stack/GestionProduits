@page "{id:int}"
@model GestionProduits.Pages.Categories.EditModel
@{ ViewData["Title"] = "Modifier la catégorie"; }
<h1>Modifier la catégorie</h1><form method="post"><input type="hidden" asp-for="Categorie.Id" /><label asp-for="Categorie.Nom"></label><input asp-for="Categorie.Nom" class="form-control" /><span asp-validation-for="Categorie.Nom" class="text-danger"></span><button type="submit" class="btn btn-success">Enregistrer</button> <a asp-page="Index">Annuler</a></form>
